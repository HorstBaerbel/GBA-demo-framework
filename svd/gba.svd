    <peripheral>
      <name>Keypad Input</name>
      <description>Keypad Input</description>
      <baseAddress>0x04000130</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x12</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>KEYINPUT</name>
          <description>Active-low state of all keypad buttons</description>
          <addressOffset>0x0</addressOffset>
          <size>16</size>
          <access>read-only</access>
          <resetValue>0x3FF</resetValue>
          <fields>
            <field>
              <name>ButtonA</name>
              <description>Button A state; 0=pressed, 1=released</description>
              <bitRange>[0:0]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Pressed</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Released</name>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ButtonB</name>
              <description>Button B state; 0=pressed, 1=released</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>Select</name>
              <description>Select state; 0=pressed, 1=released</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>Start</name>
              <description>Start state; 0=pressed, 1=released</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>Right</name>
              <description>Right direction pad state; 0=pressed, 1=released</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>Left</name>
              <description>Left direction pad state; 0=pressed, 1=released</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>Up</name>
              <description>Up direction pad state; 0=pressed, 1=released</description>
              <bitRange>[6:6]</bitRange>
            </field>
            <field>
              <name>Down</name>
              <description>Down direction pad state; 0=pressed, 1=released</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>ButtonR</name>
              <description>Right shoulder button state; 0=pressed, 1=released</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>ButtonL</name>
              <description>Left shoulder button state; 0=pressed, 1=released</description>
              <bitRange>[9:9]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>KEYCNT</name>
          <description>Configures the keypad IRQ condition</description>
          <addressOffset>0x2</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>ButtonA</name>
              <description>Enable interrupt on A key</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>ButtonB</name>
              <description>Enable interrupt on B key</description>
              <bitRange>[1:1]</bitRange>
            </field>
            <field>
              <name>Select</name>
              <description>Enable interrupt on Select key</description>
              <bitRange>[2:2]</bitRange>
            </field>
            <field>
              <name>Start</name>
              <description>Enable interrupt on Start key</description>
              <bitRange>[3:3]</bitRange>
            </field>
            <field>
              <name>Right</name>
              <description>Enable interrupt on Right key</description>
              <bitRange>[4:4]</bitRange>
            </field>
            <field>
              <name>Left</name>
              <description>Enable interrupt on Left key</description>
              <bitRange>[5:5]</bitRange>
            </field>
            <field>
              <name>Up</name>
              <description>Enable interrupt on Up key</description>
              <bitRange>[6:6]</bitRange>
            </field>
            <field>
              <name>Down</name>
              <description>Enable interrupt on Down key</description>
              <bitRange>[7:7]</bitRange>
            </field>
            <field>
              <name>ButtonR</name>
              <description>Enable interrupt on R key</description>
              <bitRange>[8:8]</bitRange>
            </field>
            <field>
              <name>ButtonL</name>
              <description>Enable interrupt on L key</description>
              <bitRange>[9:9]</bitRange>
            </field>
            <field>
              <name>IRQEnable</name>
              <description>Enable keypad interrupt generation</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>IRQCondition</name>
              <description>0=OR of selected keys, 1=AND of selected keys</description>
              <bitRange>[15:15]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>OR</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>AND</name>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
