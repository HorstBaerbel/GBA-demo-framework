          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>SRAM Wait Control</name>
              <description/>
              <bitRange>1-0</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Wait State 0 First Access</name>
              <description/>
              <bitRange>3-2</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Wait State 1 First Access</name>
              <description/>
              <bitRange>6-5</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Wait State 2 First Access</name>
              <description/>
              <bitRange>9-8</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>4</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PHI Terminal Output</name>
              <description/>
              <bitRange>12-11</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Game Pak Type Flag</name>
              <description/>
              <bitRange>15</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GBA</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CGB) (IN35 signal</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IME</name>
          <description>Interrupt Master Enable Register</description>
          <addressOffset>0x208</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>Disable all interrupts</name>
              <description/>
              <bitRange>0</bitRange>
