      <name>Interrupt, Waitstate, and Power-Down Control</name>
      <description>Interrupt, Waitstate, and Power-Down Control</description>
      <baseAddress>0x4000000</baseAddress>
      <addressBlock>
        <offset>0x200</offset>
        <size>0x109</size>
