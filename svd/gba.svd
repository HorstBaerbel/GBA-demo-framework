              <description/>
              <bitRange>2-0</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Video Mode 0-5</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Prohibited</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
