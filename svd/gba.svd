    <peripheral>
      <name>DMA Transfer Channels</name>
      <description>DMA Transfer Channels</description>
      <baseAddress>0x040000B0</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x48</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DMA0SAD</name>
          <description>DMA 0 Source Address</description>
          <addressOffset>0x0</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DMA0SAD</name>
              <description>DMA 0 source address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA0DAD</name>
          <description>DMA 0 Destination Address</description>
          <addressOffset>0x4</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DMA0DAD</name>
              <description>DMA 0 Destination Address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA0CNT_L</name>
          <description>DMA 0 Word Count</description>
          <addressOffset>0x8</addressOffset>
          <size>16</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DMA0CNT_L</name>
              <description>DMA 0 Word Count</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA0CNT_H</name>
          <description>DMA 0 Control</description>
          <addressOffset>0xA</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DestControl</name>
              <description>Destination address adjustment.</description>
              <bitRange>[6:5]</bitRange>
            </field>
            <field>
              <name>SrcControl</name>
              <description>Source address adjustment.</description>
              <bitRange>[8:7]</bitRange>
            </field>
            <field>
              <name>Repeat</name>
              <description>Repeat the transfer at the selected timing.</description>
              <bitRange>[9:9]</bitRange>
            </field>
            <field>
              <name>TransferType</name>
              <description>Transfer width: 0=16-bit, 1=32-bit.</description>
              <bitRange>[10:10]</bitRange>
            </field>
            <field>
              <name>GamePakDRQ</name>
              <description>Use Game Pak DRQ timing.</description>
              <bitRange>[11:11]</bitRange>
            </field>
            <field>
              <name>StartTiming</name>
              <description>Start timing: 0=immediate, 1=VBlank, 2=HBlank, 3=special.</description>
              <bitRange>[13:12]</bitRange>
            </field>
            <field>
              <name>IRQEnable</name>
              <description>Generate an interrupt when the transfer completes.</description>
              <bitRange>[14:14]</bitRange>
            </field>
            <field>
              <name>DMAEnable</name>
              <description>Enable the DMA channel.</description>
              <bitRange>[15:15]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA1SAD</name>
          <description>DMA 1 Source Address</description>
          <addressOffset>0xC</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DMA1SAD</name>
              <description>DMA 1 Source Address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA1DAD</name>
          <description>DMA 1 Destination Address</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>DMA1DAD</name>
              <description>DMA 1 Destination Address</description>
              <bitOffset>0</bitOffset>
              <bitWidth>32</bitWidth>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DMA1CNT_L</name>
          <description>DMA 1 Word Count</description>
          <addressOffset>0x14</addressOffset>
          <size>16</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
