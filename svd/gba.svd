          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>MasterVolumeRight</name>
              <description>Master volume for PSG channels on the right output.</description>
              <bitRange>[2:0]</bitRange>
            </field>
            <field>
              <name>MasterVolumeLeft</name>
              <description>Master volume for PSG channels on the left output.</description>
              <bitRange>[6:4]</bitRange>
            </field>
            <field>
              <name>ChannelEnableRight</name>
              <description>Enable flags for PSG channels on the right output.</description>
              <bitRange>[11:8]</bitRange>
            </field>
            <field>
              <name>ChannelEnableLeft</name>
              <description>Enable flags for PSG channels on the left output.</description>
              <bitRange>[15:12]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>SOUNDCNT_H</name>
          <description>Control Mixing/DMA Control</description>
          <addressOffset>0x22</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>PSGVolume</name>
              <description>PSG channel volume: 0=25%, 1=50%, 2=100%, 3=prohibited.</description>
              <bitRange>[1:0]</bitRange>
            </field>
            <field><name>FIFOAVolume</name><description>FIFO A volume: 0=50%, 1=100%.</description><bitRange>[2:2]</bitRange></field>
            <field><name>FIFOBVolume</name><description>FIFO B volume: 0=50%, 1=100%.</description><bitRange>[3:3]</bitRange></field>
            <field><name>FIFOARight</name><description>Enable FIFO A on the right output.</description><bitRange>[8:8]</bitRange></field>
            <field><name>FIFOALeft</name><description>Enable FIFO A on the left output.</description><bitRange>[9:9]</bitRange></field>
            <field><name>FIFOATimer</name><description>FIFO A timer select: 0=Timer 0, 1=Timer 1.</description><bitRange>[10:10]</bitRange></field>
            <field><name>FIFOAReset</name><description>Reset FIFO A.</description><bitRange>[11:11]</bitRange></field>
            <field><name>FIFOBRight</name><description>Enable FIFO B on the right output.</description><bitRange>[12:12]</bitRange></field>
            <field><name>FIFOBLeft</name><description>Enable FIFO B on the left output.</description><bitRange>[13:13]</bitRange></field>
            <field><name>FIFOBTimer</name><description>FIFO B timer select: 0=Timer 0, 1=Timer 1.</description><bitRange>[14:14]</bitRange></field>
            <field><name>FIFOBReset</name><description>Reset FIFO B.</description><bitRange>[15:15]</bitRange></field>
          </fields>
        </register>
        <register>
          <name>SOUNDCNT_X</name>
          <description>Control Sound on/off (NR52)</description>
          <addressOffset>0x24</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field><name>Channel1On</name><description>Channel 1 active status.</description><bitRange>[0:0]</bitRange><access>read-only</access></field>
            <field><name>Channel2On</name><description>Channel 2 active status.</description><bitRange>[1:1]</bitRange><access>read-only</access></field>
            <field><name>Channel3On</name><description>Channel 3 active status.</description><bitRange>[2:2]</bitRange><access>read-only</access></field>
            <field><name>Channel4On</name><description>Channel 4 active status.</description><bitRange>[3:3]</bitRange><access>read-only</access></field>
            <field><name>MasterEnable</name><description>Enable PSG and FIFO sound output.</description><bitRange>[7:7]</bitRange></field>
          </fields>
        </register>
