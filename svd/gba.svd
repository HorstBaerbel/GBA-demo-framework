            <field>
              <name>None</name>
              <description>No color special effect is selected.</description>
              <bitRange>[0:0]</bitRange>
            </field>
            <field>
              <name>Alpha Blending</name>
              <description>Selects alpha blending as the color special effect.</description>
              <bitRange>[1:1]</bitRange>
            </field>
          </fields>
        </register>
        <register>
          <name>BLDALPHA</name>
          <description>Alpha Blending Coefficients</description>
