        <size>0x64</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DISPCNT</name>
          <description>LCD Control</description>
          <addressOffset>0x0</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>BGMode</name>
              <description>Background mode selection.</description>
              <bitRange>[2:0]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Mode 0</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode 1</name>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode 2</name>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode 3</name>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode 4</name>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode 5</name>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CGBMode</name>
              <description>Selects GBA or CGB compatibility mode.</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GBA</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CGB; can be set only by BIOS opcodes</name>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FrameSelect</name>
              <description>Selects the displayed framebuffer.</description>
              <bitRange>[4:4]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Frame 0</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HBlankFree</name>
              <description>Allows OAM access during H-Blank when set.</description>
              <bitRange>[5:5]</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Normal</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Allow access to OAM during H-Blank</name>
                  <value>0x1</value>
