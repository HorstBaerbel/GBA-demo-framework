        <register>
          <name>WINOUT</name>
          <description>Inside of OBJ Window &amp; Outside of Windows</description>
          <addressOffset>0x4A</addressOffset>
          <size>16</size>
          <access>read-write</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>WINOUT</name>
              <description>Inside of OBJ Window &amp; Outside of Windows</description>
              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
