              <bitOffset>0</bitOffset>
              <bitWidth>16</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>BLDY</name>
          <description>Brightness (Fade-In/Out) Coefficient</description>
