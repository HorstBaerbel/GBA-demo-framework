              <name>H-Blank Interval Free</name>
              <description/>
              <bitRange>5</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Allow access to OAM during H-Blank</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Forced Blank</name>
