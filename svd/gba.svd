                <enumeratedValue>
                  <name>GBA</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CGB; can be set only by BIOS opcodes</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Display Frame Select</name>
              <description/>
              <bitRange>4</bitRange>
