    <peripheral>
      <name>DMA Transfer Channels</name>
      <description>DMA Transfer Channels</description>
      <baseAddress>0x4000000</baseAddress>
      <addressBlock>
        <offset>0xB0</offset>
        <size>0x48</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>DMA0SAD</name>
          <description>DMA 0 Source Address</description>
          <addressOffset>0xB0</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>Dest Addr Control</name>
              <description/>
              <bitRange>6-5</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Increment</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Decrement</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Fixed</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Increment/Reload</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA Repeat</name>
              <description/>
              <bitRange>9</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Off</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>On) (Must be zero if Bit 11 set</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA Transfer Type</name>
              <description/>
              <bitRange>10</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>16bit</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32bit</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>Game Pak DRQ  - DMA3 only -</name>
              <description/>
              <bitRange>11</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Normal</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DRQ &lt;from&gt; Game Pak</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA Start Timing</name>
              <description/>
              <bitRange>13-12</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Immediately</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>VBlank</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HBlank</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Special</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IRQ upon end of Word Count</name>
              <description/>
              <bitRange>14</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA Enable</name>
              <description/>
              <bitRange>15</bitRange>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Off</name>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>On</name>
                  <value>0x0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
